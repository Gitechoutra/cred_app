# Vite inlines these at BUILD time — a rebuild is required after any change,
# and nothing secret belongs here: every value ships to the browser.

VITE_API_BASE_URL=http://localhost:5050/v1

# Must match CASHFREE_ENV on the backend. 'sandbox' drives the Cashfree test
# checkout; 'production' charges real cards.
VITE_CASHFREE_MODE=sandbox
