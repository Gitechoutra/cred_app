Backend=DEV

# ── Database ──────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:Mahesh2605@localhost:3306/cashu_db

# ── App ───────────────────────────────────────────────────
APP_SECRET_KEY=
FRONTEND_BASE_URL=http://localhost:3000

# ── JWT (PRD FR-001: 15-min access, 30-day rotating refresh) ──
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Field-level PII encryption (AES-256-GCM, PRD 17.1) ────
# 32 random bytes, base64. Regenerate for each environment:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes every encrypted PAN, Aadhaar and account number
# permanently unreadable.
FIELD_ENCRYPTION_KEY=

# ── Vendor adapters ───────────────────────────────────────
# True = simulated rails, no real money moves. All nine PRD section 21
# integrations are still "To Be Confirmed", so this stays True.
USE_SANDBOX_ADAPTERS=True

# ── Credit bureau (credit score) ──────────────────────────
# SANDBOX = simulated, labelled demo scores (development only).
# DECENTRO = real Experian / CRIF / Equifax pull via Decentro.
# Get credentials at https://decentro.tech (staging first, then production
# after their onboarding and agreement). CIBIL is not offered by Decentro.
BUREAU_PROVIDER=SANDBOX
DECENTRO_ENV=STAGING
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_BUREAU_CODE=EX
DECENTRO_INQUIRY_PURPOSE=CC
CREDIT_SCORE_CHECKS_PER_DAY=3

# ── Cashfree (PG + Payouts + Verification Suite) ──────────
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_RETURN_URL=http://localhost:3000/payment/status
CASHFREE_NOTIFY_URL=

# ── Mail ──────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@cashu.app

# ── SMS (DLT-registered gateway; none signed yet) ─────────
SMS_PROVIDER_KEY=

# ── Bootstrap administrator ───────────────────────────────
# Required - there are no built-in defaults. The admin in the database is synced
# from these on every backend start: a new MPIN is hashed and saved (lockout
# cleared), a new phone moves the same admin. While `python app.py` is running,
# saving this file restarts it and applies the change. Without the server:
#     python -m portal.seeders.seed_admin
# Never edit users.mpin_hash by hand - it stores a salted hash, not the MPIN.
ADMIN_SEED_PHONE=9999999999
ADMIN_SEED_EMAIL=admin@cashu.app
ADMIN_SEED_NAME=CashU Administrator
ADMIN_SEED_MPIN=

# -- Razorpay (UPI collection for EMI payments) -------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_UPI_ENABLED=True
RAZORPAY_TEST_UPI_VPA=

CARD_TEST_MODE=
