Backend=DEV

# ── Database ──────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:Mahesh2605@localhost:3306/cashu_db

# ── App ───────────────────────────────────────────────────
APP_SECRET_KEY=
FRONTEND_BASE_URL=http://localhost:3000

# ── JWT (PRD FR-001: 15-min access, 30-day rotating refresh) ──
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Field-level PII encryption (AES-256-GCM, PRD 17.1) ────
# 32 random bytes, base64. Regenerate for each environment:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes every encrypted PAN, Aadhaar and account number
# permanently unreadable.
FIELD_ENCRYPTION_KEY=

# ── Vendor adapters ───────────────────────────────────────
# True = simulated rails, no real money moves. All nine PRD section 21
# integrations are still "To Be Confirmed", so this stays True.
USE_SANDBOX_ADAPTERS=True

# ── Cashfree (PG + Payouts + Verification Suite) ──────────
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_RETURN_URL=http://localhost:3000/transfer/status
CASHFREE_NOTIFY_URL=

# ── Mail ──────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@cashu.app

# ── SMS (DLT-registered gateway; none signed yet) ─────────
SMS_PROVIDER_KEY=

# ── Bootstrap administrator ───────────────────────────────
ADMIN_SEED_PHONE=9999999999
ADMIN_SEED_EMAIL=admin@cashu.app
ADMIN_SEED_NAME=CashU Administrator
ADMIN_SEED_MPIN=

