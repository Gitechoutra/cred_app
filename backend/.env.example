# CashU backend — copy to .env and fill in. NEVER commit .env.

Backend=DEV

# ── Database ──────────────────────────────────────────────
# docker compose overrides this to point at the `db` service.
DATABASE_URL=mysql+pymysql://root:Mahesh2605@localhost:3307/cashu_db

# ── App ───────────────────────────────────────────────────
APP_SECRET_KEY=change-me-in-production
FRONTEND_BASE_URL=http://localhost:3000

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── Mail ──────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@cashu.app

# ── Password reset ────────────────────────────────────────
RESET_TOKEN_SECRET=change-me
RESET_TOKEN_SALT=change-me
RESET_TOKEN_EXPIRES=3600

# ── SMS / OTP ─────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
FAST2SMS_API_KEY=

# ── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
